{
  "type": "module",
  "name": "platefinder-gr",
  "version": "1.0.0",
  "description": "Find Greek car registration area from license plate",
  "author": "Christos Kargas (https://github.com/chrikar)",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --config jest.config.cjs"
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/jest",
        "jest"
      ]
    }
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@vercel/analytics": "^2.0.1",
    "expo": "~57.0.28",
    "expo-haptics": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@eslint/js": "^9.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "ts-jest": "^29.4.9"
  },
  "overrides": {
    "minimatch": "^10.2.6",
    "brace-expansion": "^5.0.12",
    "js-yaml": "^4.3.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
